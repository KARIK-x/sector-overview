# Copy to .env and adjust. Never commit .env.
# SQLite is the default local database. For production use a PostgreSQL URL,
# e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/sector_intelligence.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: GitHub token raises the raw.githubusercontent rate limit during ingestion.
GITHUB_TOKEN=
